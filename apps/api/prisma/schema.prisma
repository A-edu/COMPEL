generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entity {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  dataOfficeEmail String
  createdAt       DateTime @default(now())

  users               User[]
  requestsAsRequester DataSharingRequest[] @relation("RequestingEntity")
  requestsAsProvider  DataSharingRequest[] @relation("ProvidingEntity")
}

enum UserRole {
  DPO
  COMPLIANCE_OFFICER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  isActive  Boolean  @default(true)
  role      UserRole @default(DPO)
  createdAt DateTime @default(now())

  otpChallenges     OtpChallenge[]
  sessions          Session[]
  authEvents        AuthEvent[]
  submittedRequests DataSharingRequest[] @relation("SubmittedBy")
  uploadedDocuments Document[]
  providerResponses ProviderResponse[]
  decisions         Decision[]
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  lastSeenAt DateTime
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AuthEventType {
  OTP_REQUESTED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_EXPIRED
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  email     String
  type      AuthEventType
  ip        String?
  createdAt DateTime      @default(now())
}

enum RequestStatus {
  AWAITING_PROVIDER_RESPONSE
  // Sprint 3 spec §3.1: the provider responded (or corrected) and a pipeline
  // run is in progress. Never flagged while in this status.
  UNDER_AUTOMATED_REVIEW
  PROVIDER_RESPONDED
  APPROVED
  REJECTED
}

model DataSharingRequest {
  id                 String        @id @default(cuid())
  reference          String        @unique
  title              String
  requestingEntityId String
  requestingEntity   Entity        @relation("RequestingEntity", fields: [requestingEntityId], references: [id])
  providingEntityId  String
  providingEntity    Entity        @relation("ProvidingEntity", fields: [providingEntityId], references: [id])
  submittedById      String
  submittedBy        User          @relation("SubmittedBy", fields: [submittedById], references: [id])
  status             RequestStatus @default(AWAITING_PROVIDER_RESPONSE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents        Document[]
  providerResponse ProviderResponse?
  flagReasons      FlagReason[]
  decision         Decision?
  pipelineRuns     PipelineRun[]
  findings         Finding[]
}

enum DocumentKind {
  REQUEST_FORM
  SUPPORTING
  ROPA
}

model Document {
  id           String             @id @default(cuid())
  requestId    String
  request      DataSharingRequest @relation(fields: [requestId], references: [id])
  kind         DocumentKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())

  providerResponse ProviderResponse?
}

enum Position {
  ENDORSED
  OBJECTED
}

model ProviderResponse {
  id              String             @id @default(cuid())
  requestId       String             @unique
  request         DataSharingRequest @relation(fields: [requestId], references: [id])
  ropaDocumentId  String             @unique
  ropaDocument    Document           @relation(fields: [ropaDocumentId], references: [id])
  position        Position
  objectionReason String?
  respondedById   String
  respondedBy     User               @relation(fields: [respondedById], references: [id])
  createdAt       DateTime           @default(now())
}

// Why a request needs an officer's decision (Sprint 2 spec §3.2). A request
// with at least one is flagged, so a flag is never a status of its own and
// the requester's status cannot reveal one. `source` is a plain string so a
// new source needs no migration.
//
// Sprint 3 spec §3.2: a reason raised by a pipeline finding points to it
// through `findingId`; an objection or a pipeline error has none. Only
// reasons with no `supersededAt` are active, and only active reasons count
// towards a request being flagged (ACTIVE_REASON in flag-reasons.ts).
model FlagReason {
  id           String             @id @default(cuid())
  requestId    String
  request      DataSharingRequest @relation(fields: [requestId], references: [id])
  source       String
  text         String
  findingId    String?            @unique
  finding      Finding?           @relation(fields: [findingId], references: [id], onDelete: Restrict)
  supersededAt DateTime?
  createdAt    DateTime           @default(now())

  @@index([requestId])
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

// Who made a decision (Sprint 3 spec §2.6, §3.5).
enum DecisionMaker {
  OFFICER
  SYSTEM
}

// The final decision on a request (Sprint 2 spec §3.3, Sprint 3 spec §3.5).
// Decided once: the unique requestId is what makes a second decision
// impossible, even when two officers decide at the same moment.
//
// An officer's decision names the officer and holds a justification. A system
// decision is an approval under the outcome rule, with the check report in
// place of a justification. A database CHECK (migration
// 20261121150000_findings_and_system_decisions) enforces both shapes, so the
// system can never record a rejection. `report` is the full check report as
// it stood when the decision was recorded (§9.3); null for an officer
// decision on a request with no pipeline run.
model Decision {
  id            String             @id @default(cuid())
  requestId     String             @unique
  request       DataSharingRequest @relation(fields: [requestId], references: [id])
  outcome       DecisionOutcome
  madeBy        DecisionMaker      @default(OFFICER)
  justification String?
  decidedById   String?
  decidedBy     User?              @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  report        Json?
  createdAt     DateTime           @default(now())
}

enum PipelineRunTrigger {
  RESPONSE
  CORRECTION
}

enum PipelineRunState {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// One automated review of a request (Sprint 3 spec §3.1, §4.3). Each step runs
// in its own internal request: a step is claimed by moving the run from
// QUEUED to RUNNING with a lease, so a step never runs twice, and a run whose
// lease lapses is ended FAILED by the sweeper rather than repeated.
model PipelineRun {
  id             String             @id @default(cuid())
  requestId      String
  request        DataSharingRequest @relation(fields: [requestId], references: [id])
  trigger        PipelineRunTrigger
  state          PipelineRunState   @default(QUEUED)
  // Step name -> model used, snapshotted when the run is created.
  models         Json
  ruleSetVersion String
  // Index into the ordered step list of the step to run next.
  nextStep       Int                @default(0)
  // Results saved by each step, keyed by step name, so any instance can
  // continue the run.
  stepResults    Json               @default("{}")
  leaseUntil     DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  findings Finding[]

  @@index([requestId])
  @@index([state])
}

// A finding's result (Sprint 3 spec §3.2), as the check allows (§7).
enum FindingResult {
  PASSED
  FAILED
  NOT_FOUND
  AMBIGUOUS
  INCONSISTENT
  COMPATIBLE
  INCOMPATIBLE
  INDETERMINATE
}

// The result of one check on one request (Sprint 3 spec §3.2). Written when
// the run that produced it completes. The check's name, clause, rule-set
// version and whether the requester may see it are copied from the rule set
// at that time, so a later rule-set change never changes what a stored
// finding said (§3.4). `evidence` lists the documents and extracted values it
// rests on. A later run of the same check marks it superseded.
model Finding {
  id               String             @id @default(cuid())
  requestId        String
  request          DataSharingRequest @relation(fields: [requestId], references: [id])
  runId            String
  run              PipelineRun        @relation(fields: [runId], references: [id])
  checkId          String
  checkName        String
  result           FindingResult
  citation         String
  ruleSetVersion   String
  requesterVisible Boolean
  explanation      String
  evidence         Json
  supersededAt     DateTime?
  createdAt        DateTime           @default(now())

  flagReason FlagReason?

  @@index([requestId])
  @@index([runId])
}

// The last sequence number issued per year for request references
// (CMP-YYYY-NNNNNN, spec §3 -> Reference generation). Incremented inside the
// transaction that creates the request; the row lock serialises concurrent
// submissions.
model ReferenceCounter {
  year      Int      @id
  lastValue Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
